@model List<InventoryManagment.Application.Contract.Inventory.InventoryOperationViewModel>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
    <h4 class="modal-title">Inventory Log</h4>
</div>

<div class="modal-body">
    <table  class="table table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Count</th>
                <th>Date</th>
                <th>Current Count</th>
                <th>Action</th>
                <th>Operator(+ ,-)</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr class="text-white @(item.Operation ? "bg-success" : "bg-danger")">
                    <td> @item.Id </td>
                    <td> @item.Count </td>
                    <td> @item.OperaionDate </td>
                    <td> @item.CurrentCount </td>
                    <td>
                        @if(item.Operation)
                        {
                            <span>Increase</span>
                        }else
                        {
                            <span>Reduce</span>
                        }
                    </td>
                    <td> @item.Operator </td>
                    <td> @item.Description </td>
                </tr>
            }      
        </tbody>
    </table>
</div>


<div class="modal-footer">
    
</div>
