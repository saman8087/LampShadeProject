@page
@model ServiceHost.Areas.Administration.Pages.Shop.Products.IndexModel
@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "Product Managment";
}
@section Scripts {
    <script src="~/adminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#datatable').dataTable();
        });
    </script>
}
<div class="row">
    <div class="col-sm-12">
        <h4 class="page-title pull-right">@ViewData["title"]</h4>
        <p class="pull-left">
            <a class="btn btn-success btn-lg" href="#showmodal=@Url.Page("./Index", "Create")">Create New Product </a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Search in Products </h3>
            </div>
            <div class="panel-body">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.Name"></label>
                        <input class="form-control" asp-for="SearchModel.Name" placeholder="Product Name">
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="@Model.SearchModel.CategoryId"></label>
                        <select class="form-control" asp-for="@Model.SearchModel.CategoryId" asp-items="@Model.ProductCategories">
                            <option value="0"> Product category ...</option>

                        </select>
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="@Model.SearchModel"></label>
                        <input class="form-control" asp-for="@Model.SearchModel.Code" placeholder="Product  Code">
                    </div>
                    <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">Search</button>
                    <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">See All</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row" id="ProductCategoriesDiv">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Products List</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Picture</th>
                                    <th>Name</th>
                                    <th>Code</th>
                                    <th>Category</th>
                                    <th>Price</th>
                                    <th>Is In Stock</th>
                                    <th>Client</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Products)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>
                                            <img src="@item.Picture" style="width: 70px ; height: 70px" />
                                        </td>
                                        <td>@item.Name</td>
                                        <td>@item.Code</td>
                                        <td>@item.Category</td>
                                        <td>@item.UnitPrice</td>
                                        <td>
                                            @if(item.IsInStock)
                                            {
                                                <i class="fa fa-check fa-3x text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="fa fa-remove fa-3x text-danger" ></i>
                                            }
                                        </td>
                                        <td>@item.CreatioDate</td>
                                        <td>
                                            <a class="btn btn-warning puu-right m-r1-5" href="#showmodal=@Url.Page("./Index","Edit", new {id = item.Id})">
                                                <i class="fa fa-edit"></i> Edit
                                                </a>
                                            @if(item.IsInStock)
                                            {
                                                <a asp-page="./Index" asp-page-handler="NotInStock" asp-route-id="@item.Id" class="btn btn-outline-danger"> Inventory is empty </a>

                                            }
                                            else
                                            {
                                                <a asp-page="./Index" asp-page-handler="NotInStock" asp-route-id="@item.Id" class="btn btn-outline-success"> Inventory is Updated </a>

                                            }
                                        </td>
                                    </tr>


                                }
                                
                                
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

